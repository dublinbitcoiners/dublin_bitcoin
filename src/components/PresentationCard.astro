---
import type { CollectionEntry } from "astro:content";

type Props = {
  presentation: CollectionEntry<"presentations">;
};

const { presentation } = Astro.props;
const { title, speaker, kind, url, summary, tags } = presentation.data;
const base = import.meta.env.BASE_URL;
const withBase = (target: string) => `${base.replace(/\/$/, "")}/${target.replace(/^\//, "")}`;
const slug = presentation.id.replace(/\.mdx?$/, "");
const resolveHref = (target?: string) => {
  if (!target) return undefined;
  if (/^https?:\/\//.test(target)) return target;
  return withBase(target);
};
const href = kind === "html" ? withBase(`presentations/${slug}/`) : resolveHref(url);
const actionLabel = kind === "pdf" ? "Open PDF" : kind === "external" ? "Open link" : "View deck";
---

<article class="presentation-card">
  <div>
    <h3>{href ? <a href={href}>{title}</a> : title}</h3>
  </div>
  <div class="presentation-details">
    <p class="meta">{speaker}</p>
    <p>{summary}</p>
    <div class="tags" aria-label="Tags">
      {tags.map((tag) => <span>{tag}</span>)}
    </div>
    {href && <a class="card-action" href={href}>{actionLabel}</a>}
  </div>
</article>
